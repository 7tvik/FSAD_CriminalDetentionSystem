# ===== Backend / Database =====
# MySQL connection (used by Spring Boot backend and docker-compose)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cdp
DB_USERNAME=cdp_user
DB_PASSWORD=change_me_local_only
MYSQL_ROOT_PASSWORD=change_me_root_local_only

# ===== JWT =====
# Must be a long random string (>= 32 bytes) for HS256. Generate your own; never commit the real value.
JWT_SECRET=please_change_this_to_a_long_random_secret_at_least_32_bytes
JWT_EXPIRATION_MS=86400000

# ===== CORS =====
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ===== Server =====
SERVER_PORT=8080

# ===== Frontend =====
VITE_API_BASE_URL=http://localhost:8080/api
