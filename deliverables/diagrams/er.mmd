    ROLES {
        bigint id PK
        varchar name UK
        varchar description
    }
    PERMISSIONS {
        bigint id PK
        varchar name UK
        varchar description
    }
    USERS {
        bigint id PK
        varchar username UK
        varchar email UK
        varchar password_hash
        varchar full_name
        boolean active
    }
    USER_ROLES {
        bigint user_id PK,FK
        bigint role_id PK,FK
    }
    ROLE_PERMISSIONS {
        bigint role_id PK,FK
        bigint permission_id PK,FK
    }
    STAFF {
        bigint id PK
        bigint user_id FK
        varchar staff_number UK
        varchar full_name
        varchar rank_title
        boolean active
    }
    PRISONERS {
        bigint id PK
        varchar prisoner_number UK
        varchar first_name
        varchar last_name
        date admission_date
        varchar status
        date expected_release_date
        boolean active
    }
    CASES {
        bigint id PK
        bigint prisoner_id FK
        varchar case_number UK
        varchar fir_number
        varchar crime_type
        varchar court
        varchar sections
        varchar status
    }
    SURRENDERED_ARTICLES {
        bigint id PK
        bigint prisoner_id FK
        varchar name
        int quantity
        date received_date
        varchar return_status
    }
    RELEASE_RECORDS {
        bigint id PK
        bigint prisoner_id FK
        bigint authorized_by FK
        date expected_release_date
        varchar release_type
        varchar status
        date actual_release_date
    }
    DUTY_REGISTER {
        bigint id PK
        bigint staff_id FK
        bigint created_by FK
        varchar location
        date duty_date
        time start_time
        time end_time
    }
    INTERVIEW_REQUESTS {
        bigint id PK
        bigint prisoner_id FK
        bigint reviewed_by FK
        varchar visitor_name
        date requested_date
        varchar status
    }
    MOVEMENTS {
        bigint id PK
        bigint escort_officer FK
        varchar person_type
        varchar movement_type
        datetime time_out
        datetime expected_return
        datetime actual_return
        varchar status
    }
    COURT_HEARINGS {
        bigint id PK
        bigint movement_id FK,UK
        bigint prisoner_id FK
        bigint case_id FK
        bigint escort_officer FK
        varchar court
        date hearing_date
        varchar status
        varchar outcome
    }
    NOTIFICATIONS {
        bigint id PK
        bigint recipient_user_id FK
        varchar type
        varchar title
        boolean read_flag
    }
    AUDIT_LOGS {
        bigint id PK
        bigint user_id FK
        varchar action
        varchar entity_type
        text old_value
        text new_value
    }
