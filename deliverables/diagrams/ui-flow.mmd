%%{init: {'theme':'base','themeVariables':{'primaryColor':'#eef2f7','primaryBorderColor':'#1f4e79','lineColor':'#1f4e79','fontSize':'13px'}}}%%
flowchart TB
    START(["User opens app"]) --> LOGIN["/login — Login Page<br/>username + password"]
    LOGIN -->|invalid| LOGIN
    LOGIN -->|JWT issued| GUARD{"ProtectedRoute<br/>authenticated?<br/>has permission?"}
    GUARD -->|no token| LOGIN
    GUARD -->|lacks permission| FORBID["/forbidden — 403 Page"]
    GUARD -->|authorized| LAYOUT

    subgraph LAYOUT["AppLayout — Sidebar + Topbar (role-filtered nav)"]
        direction TB
        DASH["/dashboard<br/>KPI cards + charts"]
        NOTIF["/notifications<br/>alerts · generate"]

        subgraph REG["Registers"]
            direction TB
            PRIS["/prisoners<br/>Case Register (list + search)"]
            PDET["/prisoners/:id<br/>Detail · Cases + Articles tabs"]
            REL["/releases<br/>Release records + status"]
            DIARY["/release-diary<br/>day/week/range + CSV export"]
            DUTY["/duty<br/>Duty Register"]
            MOVE["/movements<br/>In-Out Register + overdue"]
            COURT["/court<br/>Court Movements + outcome"]
            INTV["/interviews<br/>Request lifecycle"]
            PRIS --> PDET
        end

        REPORTS["/reports<br/>Daily · Monthly · Upcoming · Stats"]

        subgraph ADMIN["Administration (Admin only)"]
            direction TB
            USERS["/users<br/>User management"]
            ROLES["/roles<br/>Roles & Permissions"]
            AUDIT["/audit<br/>Audit Log (read-only)"]
        end

        PROFILE["/profile<br/>Change password"]
    end

    DASH --> REG
    DASH --> REPORTS
    DASH --> ADMIN
    SESSION{"401 / logout"} -.->|axios interceptor clears JWT| LOGIN
    LAYOUT -.-> SESSION
