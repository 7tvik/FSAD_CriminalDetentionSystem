# --- Frontend env template (copy to .env.local; do NOT commit real values) ---

# Base URL the Axios client targets. Leave as "/api" to use the Vite dev proxy,
# or set to an absolute backend URL (e.g. http://localhost:8080/api) for a built SPA.
VITE_API_BASE_URL=/api

# Optional: where the Vite dev-server proxy forwards /api requests during `npm run dev`.
VITE_API_PROXY_TARGET=http://localhost:8080
